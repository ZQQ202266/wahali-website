/
  Cache-Control: no-cache

/images/*
  Cache-Control: public, max-age=86400

/product/images/*
  Cache-Control: public, max-age=86400

/brand/*
  Cache-Control: public, max-age=86400

/custom-assets/*
  Cache-Control: public, max-age=86400

/flags/*
  Cache-Control: public, max-age=86400

/catalogue/images/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=604800

# Public HTML uses per-page robots metadata; customer utilities stay out of search.
/catalogue.pdf
  X-Robots-Tag: noindex, follow
/catalogue-print
  X-Robots-Tag: noindex, follow
/catalogue-print.html
  X-Robots-Tag: noindex, follow
/catalogue-manifest.json
  X-Robots-Tag: noindex, follow
/inquiry/*
  X-Robots-Tag: noindex, follow
/cart
  X-Robots-Tag: noindex, follow
/cart.html
  X-Robots-Tag: noindex, follow
/custom-home-preview
  X-Robots-Tag: noindex, follow
/custom-home-preview.html
  X-Robots-Tag: noindex, follow
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
